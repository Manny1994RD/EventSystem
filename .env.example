# Copy this file to .env and fill it in.

# A long random secret. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Your Tailscale address, without https:// (comma-separated if more than one).
ALLOWED_HOSTS=zima.your-tailnet.ts.net,localhost,127.0.0.1
# Same address with https:// in front.
CSRF_TRUSTED_ORIGINS=https://zima.your-tailnet.ts.net

# First admin account, created the first time the app starts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Where the data is stored on the Zima server (database, flyers, backups).
DATA_PATH=/DATA/AppData/church-events

TIME_ZONE=America/Santo_Domingo

# Set to 0 only if you open the app over plain http (not recommended).
SECURE_COOKIES=1
