# Copy this file to .env and fill in the first line. Everything else is optional.

# The address people open (your Tailscale address), with https://
APP_URL=https://zima.your-tailnet.ts.net

# Where the data is kept on the Zima server.
DATA_PATH=/DATA/AppData/church-events/data
# Where daily backups go. Best on a different drive than DATA_PATH (for example a USB disk).
BACKUP_PATH=/DATA/AppData/church-events/backups

TIME_ZONE=America/Santo_Domingo

# A secret key is created automatically the first time. Only set this if you want to choose it yourself.
# SECRET_KEY=

# Turn on the low-level Django admin at /tech-admin/ (only when the tech admin needs it).
# TECH_ADMIN_ENABLED=1

# Set to 0 only if you open the app over plain http:// (not recommended).
# SECURE_COOKIES=1
